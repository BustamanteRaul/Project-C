StashService -> IStashRepository [arrowhead=vee,label="usa"];
StashService -> ItemFactory [arrowhead=vee,label="reconstruye"];
StashService -> TransferPlan [arrowhead=vee,style=dashed,label="prepara"];
IStashRepository -> SqliteStashRepository [dir=back,arrowtail=empty,arrowhead=none,style=dashed,label="implementa"];
IStashRepository -> TransferPlan [arrowhead=vee,style=dashed,label="confirma"];
ItemFactory -> ItemCatalog [arrowhead=vee,label="consulta"];

DOM [shape=box,style="filled,rounded",label="Dominio y reglas"];
REP [shape=box,style="filled,rounded",label="Repositorio del stash"];
DB [shape=box,style="filled,rounded",label="SQLite: catálogo y stash"];
UI -> APP [arrowhead=vee];
APP -> COM [arrowhead=vee];

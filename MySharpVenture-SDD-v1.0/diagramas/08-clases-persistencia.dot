digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.35,nodesep=0.6,ranksep=0.9,splines=polyline,fontname="DejaVu Sans",fontsize=20,fontcolor="#173044",labelloc=t,compound=true];
node [fontname="DejaVu Sans",fontsize=12,color="#42667d",fontcolor="#173044",style=filled,fillcolor="#f3f7fa",margin="0.18,0.13",penwidth=1.2];
edge [fontname="DejaVu Sans",fontsize=11,color="#536c7e",fontcolor="#31536a",arrowsize=0.8,penwidth=1.2,labeldistance=1.8,labelangle=25];
label="Servicios de persistencia y catálogo";
StashService [shape=record,label="{StashService|+Deposit(Guid itemId, int quantity)\l+Withdraw(int catalogItemId, int quantity)\l}"];
IStashRepository [shape=record,label="{«interface»\nIStashRepository|+ReadEntries()\l+CommitTransfer(TransferPlan plan)\l}"];
SqliteStashRepository [shape=record,label="{SqliteStashRepository|+ReadEntries()\l+CommitTransfer(TransferPlan plan)\l}"];
ItemFactory [shape=record,label="{ItemFactory|+Create(int catalogItemId)\l}"];
ItemCatalog [shape=record,label="{ItemCatalog|+Find(int catalogItemId)\l}"];
ItemDefinition [shape=record,label="{ItemDefinition|+int CatalogItemId\l+string Code\l+ItemKind Kind\l+int? Tier\l+decimal UnitWeight\l}"];

digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.35,nodesep=0.6,ranksep=0.9,splines=polyline,fontname="DejaVu Sans",fontsize=20,fontcolor="#173044",labelloc=t,compound=true];
node [fontname="DejaVu Sans",fontsize=12,color="#42667d",fontcolor="#173044",style=filled,fillcolor="#f3f7fa",margin="0.18,0.13",penwidth=1.2];
edge [fontname="DejaVu Sans",fontsize=11,color="#536c7e",fontcolor="#31536a",arrowsize=0.8,penwidth=1.2,labeldistance=1.8,labelangle=25];
label="Modelo relacional · armas y consumibles";
ITEM_CATALOG [shape=record,label="{ITEM_CATALOG|catalog_item_id : int [PK]\lkind : string\l}"];
WEAPON_DEFINITION [shape=record,label="{WEAPON_DEFINITION|catalog_item_id : int [PK, FK]\lcategory : string\lvariant : string\ltechnology : string\lbase_damage : decimal\lstamina_cost : decimal\lbase_hit_chance : decimal\lcritical_chance : decimal\lcritical_multiplier : decimal\lmagazine_capacity : int\lammo_catalog_id : int [FK]\l}"];
ACCESSORY_DEFINITION [shape=record,label="{ACCESSORY_DEFINITION|catalog_item_id : int [PK, FK]\lslot : string\l}"];
ACCESSORY_COMPATIBILITY [shape=record,label="{ACCESSORY_COMPATIBILITY|accessory_catalog_id : int [PK, FK]\lweapon_variant : string [PK]\l}"];
CONSUMABLE_DEFINITION [shape=record,label="{CONSUMABLE_DEFINITION|catalog_item_id : int [PK, FK]\lsubtype : string\l}"];
ITEM_CATALOG -> WEAPON_DEFINITION [dir=none,taillabel="1",headlabel="0..1",label="detalle arma",style=solid];
ITEM_CATALOG -> ACCESSORY_DEFINITION [dir=none,taillabel="1",headlabel="0..1",label="detalle accesorio",style=solid];
ITEM_CATALOG -> CONSUMABLE_DEFINITION [dir=none,taillabel="1",headlabel="0..1",label="detalle consumible",style=solid];
ACCESSORY_DEFINITION -> ACCESSORY_COMPATIBILITY [dir=none,taillabel="1",headlabel="1..*",label="compatible con",style=solid];
ITEM_CATALOG -> WEAPON_DEFINITION [dir=none,taillabel="0..1",headlabel="0..*",label="es municion de",style=dashed,constraint=false];
}

digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.35,nodesep=0.6,ranksep=0.9,splines=polyline,fontname="DejaVu Sans",fontsize=20,fontcolor="#173044",labelloc=t,compound=true];
node [fontname="DejaVu Sans",fontsize=12,color="#42667d",fontcolor="#173044",style=filled,fillcolor="#f3f7fa",margin="0.18,0.13",penwidth=1.2];
edge [fontname="DejaVu Sans",fontsize=11,color="#536c7e",fontcolor="#31536a",arrowsize=0.8,penwidth=1.2,labeldistance=1.8,labelangle=25];
label="Modelo relacional · núcleo";
ITEM_CATALOG [shape=record,label="{ITEM_CATALOG|catalog_item_id : int [PK]\lcode : string [UK]\lname : string\lkind : string\ltier : int\lunit_weight_g : int\lbuy_price : int\lsell_price : int\lcan_stash : boolean\lcan_craft : boolean\lcan_dismantle : boolean\lnext_tier_id : int [FK, UK]\l}"];
STASH_ENTRY [shape=record,label="{STASH_ENTRY|catalog_item_id : int [PK, FK]\lquantity : int\l}"];
ITEM_EFFECT [shape=record,label="{ITEM_EFFECT|catalog_item_id : int [PK, FK]\leffect_order : int [PK]\leffect_code : string\lmagnitude : decimal\lduration_turns : int\l}"];
ITEM_CATALOG -> STASH_ENTRY [dir=none,taillabel="1",headlabel="0..1",label="cantidad guardada",style=solid];
ITEM_CATALOG -> ITEM_EFFECT [dir=none,taillabel="1",headlabel="0..*",label="efectos definidos",style=solid];
ITEM_CATALOG -> ITEM_CATALOG [dir=none,taillabel="0..1",headlabel="0..1",label="siguiente tier",style=dashed];
}

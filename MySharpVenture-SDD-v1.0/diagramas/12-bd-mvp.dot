digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.35,nodesep=0.6,ranksep=0.9,splines=polyline,fontname="DejaVu Sans",fontsize=20,fontcolor="#173044",labelloc=t,compound=true];
node [fontname="DejaVu Sans",fontsize=12,color="#42667d",fontcolor="#173044",style=filled,fillcolor="#f3f7fa",margin="0.18,0.13",penwidth=1.2];
edge [fontname="DejaVu Sans",fontsize=11,color="#536c7e",fontcolor="#31536a",arrowsize=0.8,penwidth=1.2,labeldistance=1.8,labelangle=25];
label="Modelo relacional · MVP";
ITEM_CATALOG [shape=record,label="{ITEM_CATALOG|catalog_item_id : int [PK]\lcode : string [UK]\lname : string\lkind : string\ltier : int\lcan_stash : boolean\l}"];
STASH_ENTRY [shape=record,label="{STASH_ENTRY|catalog_item_id : int [PK, FK]\lquantity : int\l}"];
WEAPON_DEFINITION [shape=record,label="{WEAPON_DEFINITION|catalog_item_id : int [PK, FK]\lvariant : string\lbase_damage : decimal\lbase_hit_chance : decimal\lmagazine_capacity : int\lammo_catalog_id : int [FK]\l}"];
CONSUMABLE_DEFINITION [shape=record,label="{CONSUMABLE_DEFINITION|catalog_item_id : int [PK, FK]\lsubtype : string\l}"];
ITEM_EFFECT [shape=record,label="{ITEM_EFFECT|catalog_item_id : int [PK, FK]\leffect_order : int [PK]\leffect_code : string\lmagnitude : decimal\l}"];
ITEM_CATALOG -> STASH_ENTRY [dir=none,taillabel="1",headlabel="0..1",label="cantidad guardada",style=solid];
ITEM_CATALOG -> WEAPON_DEFINITION [dir=none,taillabel="1",headlabel="0..1",label="detalle arma",style=solid];
ITEM_CATALOG -> CONSUMABLE_DEFINITION [dir=none,taillabel="1",headlabel="0..1",label="detalle consumible",style=solid];
ITEM_CATALOG -> ITEM_EFFECT [dir=none,taillabel="1",headlabel="0..*",label="efecto del objeto",style=solid];
ITEM_CATALOG -> WEAPON_DEFINITION [dir=none,taillabel="1",headlabel="0..*",label="es municion de",style=dashed,constraint=false];
}

        decimal ram_cost
    }
    ITEM_CATALOG ||--o| CYBERWARE_DEFINITION : detalle_implante
    CYBERWARE_DEFINITION ||--o| CYBERDECK_DEFINITION : detalle_cyberdeck
    ITEM_CATALOG ||--o| QUICKHACK_DEFINITION : detalle_quickhack
